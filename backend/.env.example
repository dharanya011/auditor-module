# AWS PostgreSQL credentials — copy this file to .env and fill in your values
# NEVER commit .env to version control
#
# Usage: cp .env.example .env  and then fill in the real values

# PostgreSQL host (e.g. AWS RDS endpoint or IP)
DB_HOST=

# PostgreSQL port (default 5432)
DB_PORT=5432

# Database name
DB_NAME=

# Database user
DB_USER=

# Database password
DB_PASSWORD=

# Express server port (default 3000)
PORT=3000
